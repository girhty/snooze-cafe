---
interface Props {
  image: string;
  profileImage: string;
}
const { image, profileImage } = Astro.props;
---
<section class="grain relative isolate min-h-[780px] overflow-hidden bg-espresso pt-28 text-cream lg:min-h-[820px]">
  <img src={image} alt="Snooze Café interior and coffee experience" class="absolute inset-0 -z-20 h-full w-full object-cover opacity-55" />
  <div class="absolute inset-0 -z-10 bg-gradient-to-r from-espresso via-espresso/80 to-espresso/25"></div>
  <div class="absolute bottom-0 left-0 right-0 -z-10 h-2/5 bg-gradient-to-t from-espresso to-transparent"></div>

  <div class="mx-auto grid max-w-7xl items-center gap-12 px-5 pb-16 pt-20 lg:grid-cols-[1.1fr_.9fr] lg:px-8 lg:pb-24 lg:pt-28">
    <div class="reveal is-visible">
      <div class="mb-7 inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-3 py-2 text-sm font-semibold backdrop-blur-md">
        <span class="relative flex h-2.5 w-2.5">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-[#a9d49a] opacity-75"></span>
          <span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-[#a9d49a]"></span>
        </span>
        Open now · Basrah, Iraq
      </div>
      <p class="mb-4 text-sm font-bold uppercase tracking-[.24em] text-sand">Snooze Café · غفوة كافيه</p>
      <h1 class="max-w-3xl font-display text-6xl font-bold leading-[.88] tracking-tight sm:text-7xl lg:text-[6.6rem]">
        Wake up<br />your <em class="text-caramel">wonder.</em>
      </h1>
      <p class="mt-7 max-w-xl text-lg leading-relaxed text-cream/75 sm:text-xl">
        Coffee with character. Dreamy desserts. Your most delicious pause, right here in Basrah.
      </p>
      <div class="mt-9 flex flex-wrap gap-4">
        <a data-magnetic href="#visit" class="rounded-full bg-caramel px-7 py-4 font-bold text-white shadow-glow transition duration-300 hover:bg-[#cc8050]">Plan your visit <span aria-hidden="true">↗</span></a>
        <a data-magnetic href="https://www.instagram.com/snooze.iq/" target="_blank" rel="noreferrer" class="rounded-full border border-white/30 bg-white/10 px-7 py-4 font-bold text-white backdrop-blur-md transition hover:bg-white hover:text-espresso">Follow @snooze.iq</a>
      </div>
    </div>

    <aside class="reveal reveal-delay-2 justify-self-center lg:justify-self-end">
      <div class="relative w-[280px] sm:w-[330px]">
        <div class="absolute -inset-8 rounded-full bg-caramel/25 blur-3xl"></div>
        <div class="relative rounded-[2rem] border border-white/20 bg-white/10 p-5 shadow-2xl backdrop-blur-xl">
          <div class="flex items-center gap-3">
            <img src={profileImage} alt="Snooze Café Instagram profile" class="h-14 w-14 rounded-full border-2 border-sand object-cover" />
            <div>
              <p class="font-display text-xl font-bold">Snooze Caffe</p>
              <p class="text-sm text-cream/65">@snooze.iq</p>
            </div>
          </div>
          <div class="my-5 h-px bg-white/15"></div>
          <div class="grid grid-cols-3 gap-2 text-center">
            <div><strong class="block font-display text-2xl">4.9</strong><span class="text-[10px] uppercase tracking-wider text-cream/60">Rating</span></div>
            <div><strong class="block font-display text-2xl">1.9K</strong><span class="text-[10px] uppercase tracking-wider text-cream/60">Followers</span></div>
            <div><strong class="block font-display text-2xl">∞</strong><span class="text-[10px] uppercase tracking-wider text-cream/60">Good moods</span></div>
          </div>
        </div>
        <div class="absolute -bottom-9 -left-12 rounded-full bg-cream px-5 py-3 font-display text-lg font-bold text-roast shadow-soft animate-float">
          Made with <span class="text-caramel">♥</span> in Basrah
        </div>
      </div>
    </aside>
  </div>

  <a href="#story" class="absolute bottom-7 left-1/2 flex -translate-x-1/2 flex-col items-center gap-2 text-xs font-bold uppercase tracking-[.18em] text-cream/70 transition hover:text-white" aria-label="Scroll to discover">
    Discover <span class="h-9 w-px bg-cream/50"></span>
  </a>
</section>