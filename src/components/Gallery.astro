---
interface Post {
  image: string;
  caption: string;
  type: string;
}
const { posts } = Astro.props as { posts: Post[] };
---
<section id="gallery" class="mx-auto max-w-7xl px-5 py-24 lg:px-8 lg:py-32">
  <div class="mb-12 flex flex-col justify-between gap-6 md:flex-row md:items-end">
    <div class="reveal">
      <p class="text-sm font-bold uppercase tracking-[.2em] text-caramel">Fresh from the feed</p>
      <h2 class="mt-3 font-display text-5xl font-bold leading-none sm:text-6xl">The Snooze <em>moodboard.</em></h2>
    </div>
    <a href="https://www.instagram.com/snooze.iq/" target="_blank" rel="noreferrer" class="reveal inline-flex items-center gap-2 font-bold text-roast transition hover:text-caramel">
      Explore @snooze.iq <span aria-hidden="true">↗</span>
    </a>
  </div>

  <div class="grid auto-rows-[210px] gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {posts.map((post, index) => (
      <a
        href="https://www.instagram.com/snooze.iq/"
        target="_blank"
        rel="noreferrer"
        class:list={[
          'reveal group relative overflow-hidden rounded-3xl bg-roast shadow-soft',
          index === 0 ? 'sm:col-span-2 sm:row-span-2' : '',
          index === 3 ? 'sm:row-span-2' : '',
          index === 4 ? 'sm:col-span-2' : ''
        ]}
        aria-label={`View ${post.type} on Snooze Café Instagram`}
      >
        <img src={post.image} alt={post.type} loading="lazy" class="h-full w-full object-cover transition duration-700 group-hover:scale-110" />
        <div class="absolute inset-0 bg-gradient-to-t from-espresso via-espresso/15 to-transparent opacity-80 transition duration-300 group-hover:opacity-95"></div>
        <div class="absolute inset-x-0 bottom-0 p-5 text-white">
          <p class="translate-y-6 text-xs font-bold uppercase tracking-[.17em] text-sand transition duration-300 group-hover:translate-y-0">{post.type}</p>
          <p class="mt-2 line-clamp-2 translate-y-6 text-sm leading-relaxed text-white/85 opacity-0 transition duration-300 group-hover:translate-y-0 group-hover:opacity-100">{post.caption}</p>
        </div>
        <div class="absolute right-4 top-4 rounded-full bg-white/15 px-3 py-1.5 text-xs font-bold text-white opacity-0 backdrop-blur-md transition group-hover:opacity-100">Instagram ↗</div>
      </a>
    ))}
  </div>
</section>